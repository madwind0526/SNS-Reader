{
  "name": "sns-reader",
  "version": "0.1.0",
  "private": true,
  "description": "PC app for converting SNS posts into Obsidian Markdown databases and PDF books.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && tsc -p tsconfig.node.json",
    "import:facebook": "node tools/import-facebook.mjs && node tools/validate-sns-markdown.mjs",
    "import:facebook-export": "node tools/import-facebook-export.mjs && node tools/validate-sns-markdown.mjs",
    "import:instagram-export": "node tools/import-meta-export.mjs --platform instagram && node tools/validate-sns-markdown.mjs",
    "import:threads-export": "node tools/import-meta-export.mjs --platform threads && node tools/validate-sns-markdown.mjs",
    "import:youtube-takeout": "node tools/import-youtube-takeout.mjs && node tools/validate-sns-markdown.mjs",
    "import:naver-blog-crawl": "node tools/import-naver-blog.mjs && node tools/validate-sns-markdown.mjs",
    "update:facebook": "node tools/import-facebook.mjs && node tools/validate-sns-markdown.mjs",
    "update:youtube-community": "node tools/import-youtube-community.mjs && node tools/validate-sns-markdown.mjs",
    "repair:naver-images": "node tools/repair-naver-og-images.mjs && node tools/validate-sns-markdown.mjs",
    "enrich:markdown": "node tools/enrich-sns-markdown.mjs",
    "validate:markdown": "node tools/validate-sns-markdown.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "electron:build": "tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "electron": "^43.2.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
