# UI-visible provider/model list. Do not put API keys in VITE_* variables.
VITE_LLM_PROVIDERS=local-preview,ollama,openai-frontier,gemini-flash,custom
VITE_LLM_DEFAULT_PROVIDER=ollama

# UI-visible commercial model labels only. Check each provider docs before production use.
VITE_LLM_OPENAI_FRONTIER_MODEL=gpt-5.6-sol
VITE_LLM_OPENAI_BALANCED_MODEL=gpt-5.6-terra
VITE_LLM_ANTHROPIC_OPUS_MODEL=claude-opus-4-8
VITE_LLM_ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
VITE_LLM_GEMINI_PRO_MODEL=gemini-3-pro
VITE_LLM_GEMINI_FLASH_MODEL=gemini-3.6-flash
VITE_LLM_DEEPSEEK_PRO_MODEL=deepseek-v4-pro
VITE_LLM_DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
VITE_LLM_MISTRAL_LARGE_MODEL=mistral-large-latest
VITE_LLM_MISTRAL_SMALL_MODEL=mistral-small-latest
VITE_LLM_QWEN_MAX_MODEL=qwen3.7-max

# UI-visible provider model labels.
VITE_LLM_OPENAI_MODEL=gpt-5.6-sol
VITE_LLM_ANTHROPIC_MODEL=claude-sonnet-4-6
VITE_LLM_GEMINI_MODEL=gemini-3.6-flash
VITE_LLM_OLLAMA_MODEL=gemma4:latest
VITE_LLM_CUSTOM_PROVIDER_LABEL=
VITE_LLM_CUSTOM_MODEL=

# Server-only secrets. These must be read by the Electron/backend layer, not the React UI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
QWEN_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# SNS import session settings.
# Do not store raw passwords here. Use a login window, existing browser session, or OS keychain reference.
SNS_BROWSER=chrome
SNS_BROWSER_PROFILE=Default
SNS_BROWSER_USER_DATA_DIR=
SNS_READER_CDP_URL=
SNS_READER_OBSIDIAN_FOLDER=./data/sample-md
SNS_READER_SETTINGS_FILE=./data/runtime/app-settings.json

# Facebook import.
FACEBOOK_AUTH_MODE=browser-session
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_IMPORT_LIMIT=20
FACEBOOK_CREDENTIAL_KEY=facebook-main

# Instagram import.
INSTAGRAM_AUTH_MODE=browser-session
INSTAGRAM_IMPORT_LIMIT=20
INSTAGRAM_CREDENTIAL_KEY=instagram-main

# Naver Blog import.
NAVER_BLOG_AUTH_MODE=browser-session
NAVER_BLOG_IMPORT_LIMIT=20
NAVER_BLOG_CREDENTIAL_KEY=naver-blog-main

# KakaoStory import.
KAKAO_STORY_AUTH_MODE=browser-session
KAKAO_STORY_IMPORT_LIMIT=20
KAKAO_STORY_CREDENTIAL_KEY=kakao-story-main
